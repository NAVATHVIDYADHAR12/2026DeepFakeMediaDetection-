# Normalise line endings so the repo is consistent regardless of who clones it.
* text=auto eol=lf

# Windows launcher must keep CRLF or cmd.exe can mis-parse it.
*.bat text eol=crlf

# Binary assets — never diff or convert these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.woff2 binary
*.mp4   binary
*.onnx  binary
*.npy   binary

# Notebooks are JSON; keep them out of diffs to avoid noise.
*.ipynb -diff
